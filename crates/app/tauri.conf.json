{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tauros",
  "identifier": "io.github.zannael.tauros",
  "build": { "frontendDist": "ui" },
  "app": {
    "withGlobalTauri": true,
    "windows": [{ "title": "Tauros", "width": 760, "height": 600, "resizable": true }],
    "security": { "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'" }
  },
  "bundle": { "active": false, "icon": ["icons/icon.png"] }
}
